# کپی کنید: cp .env.example .env
# پایگاه‌داده (پیش‌فرض SQLite در پوشه data). برای PostgreSQL:
#   pip install "psycopg[binary]"  و  DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/capitalpilot
# DATABASE_URL=sqlite:///./data/capitalpilot.db
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
DOCS_ENABLED=true

# دسترسی اختیاری با رمز (اگر روی سرور عمومی اجرا می‌کنید حتماً تنظیم کنید)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# دریافت خودکار قیمت (اختیاری). هیچ منبع پیش‌فرضی تعریف نشده است.
# میزبان‌های مجاز (جداشده با ویرگول) و کلید API فقط در سرور نگهداری می‌شود.
PRICE_API_ALLOWED_HOSTS=
PRICE_API_KEY=
PRICE_API_KEY_HEADER=Authorization
