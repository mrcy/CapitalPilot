# کپی کنید: cp .env.example .env     (فایل .env هرگز در Git ثبت نمی‌شود)

# ───────── عمومی ─────────
# پایگاه‌داده (پیش‌فرض SQLite در پوشهٔ data). برای PostgreSQL:
#   pip install "psycopg[binary]"  و  DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/capitalpilot
# DATABASE_URL=sqlite:///./data/capitalpilot.db
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
DOCS_ENABLED=true

# دسترسی اختیاری با رمز (اگر روی سرور عمومی اجرا می‌کنید حتماً تنظیم کنید)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ───────── امنیت کلید API ─────────
# کلیدهای API منابع قیمت که در صفحهٔ «منابع قیمت» وارد می‌شوند با Fernet رمزنگاری و فقط در سرور ذخیره می‌شوند؛
# هرگز به مرورگر برگردانده نمی‌شوند و در پشتیبان JSON هم نیستند.
# اگر خالی باشد، کلید رمزنگاری به‌صورت خودکار در data/.secret_key ساخته می‌شود (آن را پشتیبان بگیرید).
# برای محیط production مقدار ثابت بدهید (هر رشتهٔ تصادفی بلند).
SECRET_KEY=

# ───────── موتور داده‌های بازار و زمان‌بند ─────────
# کلید کلی زمان‌بند دریافت خودکار قیمت (روشن/خاموش‌کردن دقیق‌تر در صفحهٔ «منابع قیمت»).
SCHEDULER_ENABLED=true
# هر چند ثانیه یک‌بار زمان‌بند بررسی می‌کند کدام دارایی‌ها سررسید دریافت دارند.
SCHEDULER_TICK_SECONDS=30

# فهرست میزبان‌های مجاز برای منابع Custom/StreamData/Servix (جداشده با ویرگول). خالی = همهٔ میزبان‌های عمومی (غیرداخلی).
# مثال: PRICE_API_ALLOWED_HOSTS=api.example.com,data.example.org
PRICE_API_ALLOWED_HOSTS=
# اتصال به آدرس‌های شبکهٔ داخلی/localhost به‌طور پیش‌فرض مسدود است (جلوگیری از SSRF). فقط برای سرویس خودتان true کنید.
PRICE_ALLOW_PRIVATE_HOSTS=false

# ───────── نشانی و کلید منابع (همه اختیاری) ─────────
# TSETMC: نشانی‌ها از کلاینت‌های متن‌باز (pytse-client) گرفته شده‌اند. با «تست اتصال» روی شبکهٔ خودتان راستی‌آزمایی کنید.
TSETMC_BASE_URL=http://old.tsetmc.com/tsev2/data
TSETMC_SERVICE_URL=http://service.tsetmc.com/tsev2/data
# Bitpin: API عمومی (بدون کلید). فقط بازارهای تکی مثل BTC_IRT؛ سبدهای آمادهٔ سرمایه‌گذاری تیکر نیستند.
BITPIN_BASE_URL=https://api.bitpin.ir
# StreamData (سهام و شاخص خارجی) و Servix (طلا و ارز): آدرس پیش‌فرض ندارند؛ از مستندات سرویس‌دهنده بگیرید.
# جایگزین: آدرس و کلید را مستقیم در صفحهٔ «منابع قیمت» وارد کنید (کلید فقط در سرور می‌ماند).
STREAMDATA_BASE_URL=
STREAMDATA_API_KEY=
SERVIX_BASE_URL=
SERVIX_API_KEY=

# ساعات معاملهٔ بورس تهران برای تقویم بازار (شنبه تا چهارشنبه، به وقت تهران)
TSE_OPEN_TIME=08:45
TSE_CLOSE_TIME=12:45
