# پشتیبان‌گیری سازگار با SQLite (Online Backup)؛ با capitalpilot-backup.timer هر شب اجرا می‌شود.
[Unit]
Description=CapitalPilot — پشتیبان‌گیری دیتابیس
ConditionPathExists=@APP_DIR@/app/manage.py

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CAPITALPILOT_ENV_FILE=@ENV_FILE@
ExecStart=@APP_DIR@/.venv/bin/python -m app.manage backup --label daily --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@ @BACKUP_DIR@ @LOG_DIR@
